# Football Prediction System - Environment Configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git (already in .gitignore)

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=football_prediction_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# ============================================================================
# MODEL CONFIGURATION
# ============================================================================
# Minimum new matches before retraining
RETRAIN_THRESHOLD=20

# Model performance tolerance (0.98 = allow 2% degradation)
PERFORMANCE_TOLERANCE=0.98

# ============================================================================
# BETTING THRESHOLDS
# ============================================================================
MIN_PROBABILITY=0.70
MIN_VALUE_EDGE=0.05
MIN_ODDS=1.50
MAX_ODDS=3.00

# ============================================================================
# ODDS API CONFIGURATION (The Odds API - https://the-odds-api.com)
# ============================================================================

# Get your free API key at: https://the-odds-api.com/#get-access
# Free tier: 500 requests/month (~16 requests/day)
ODDS_API_KEY=your_api_key_here

# API endpoint (don't change unless using different provider)
ODDS_API_BASE_URL=https://api.the-odds-api.com/v4

# Sport key for Premier League (see /v4/sports endpoint for other leagues)
ODDS_SPORT_KEY=soccer_epl

# Regions: uk (UK bookmakers), us (US), eu (Europe), au (Australia)
# Multiple regions increase API cost: 1 request = markets × regions
ODDS_REGIONS=uk

# Markets to fetch (comma-separated)
# h2h = Match Result (Home/Draw/Away)
# totals = Over/Under 2.5 Goals  
# btts = Both Teams To Score
# Cost: 3 markets × 1 region = 3 credits per request
ODDS_MARKETS=h2h,totals,btts

# Odds format: decimal or american (decimal is easier for calculations)
ODDS_FORMAT=decimal

# Preferred bookmaker (williamhill, leovegas, casumo, etc.)
# Choose bookmakers that offer h2h + totals markets
ODDS_BOOKMAKER_PREFERENCE=williamhill

# Fallback bookmaker if preferred not available
# LeoVegas and William Hill consistently offer all markets
ODDS_BOOKMAKER_FALLBACK=leovegas
